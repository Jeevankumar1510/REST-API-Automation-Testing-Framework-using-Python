{
  "info": {
    "name": "User Management REST API - Automation Suite",
    "_postman_id": "7b8e1a2f-9c4d-4e5a-8b6f-1234567890ab",
    "description": "Production Postman collection for manual and automated API validation with pre-request scripts, dynamic environment variables, and status assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_user_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "POST /login - Authenticate & Acquire Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has access_token and bearer type\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"access_token\");",
                  "    pm.expect(json.token_type).to.eql(\"bearer\");",
                  "    pm.collectionVariables.set(\"auth_token\", json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser@example.com\",\n    \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "GET /auth/verify - Verify Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User is authenticated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"authenticated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users CRUD",
      "item": [
        {
          "name": "GET /users - Retrieve All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contains pagination metadata and data array\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"total\");",
                  "    pm.expect(json).to.have.property(\"page\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Headers contain custom metadata\", function () {",
                  "    pm.response.to.have.header(\"X-Total-Count\");",
                  "    pm.response.to.have.header(\"X-Process-Time-Ms\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "GET /users/{id} - Retrieve User by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User attributes match expected schema\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(1);",
                  "    pm.expect(json).to.have.property(\"name\");",
                  "    pm.expect(json).to.have.property(\"email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            }
          }
        },
        {
          "name": "POST /users - Create New User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(Math.random() * 100000);",
                  "pm.variables.set(\"dynamic_email\", \"postman_user_\" + randomSuffix + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has generated ID and Location header\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"created_user_id\", json.id);",
                  "    pm.response.to.have.header(\"Location\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Automation User\",\n    \"email\": \"{{dynamic_email}}\",\n    \"role\": \"tester\",\n    \"status\": \"active\",\n    \"age\": 29\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "PUT /users/{id} - Full User Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated attributes reflected\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql(\"Fully Updated Postman User\");",
                  "    pm.expect(json.role).to.eql(\"admin\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Fully Updated Postman User\",\n    \"email\": \"updated_postman@example.com\",\n    \"role\": \"admin\",\n    \"status\": \"active\",\n    \"age\": 35\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{created_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{created_user_id}}"]
            }
          }
        },
        {
          "name": "PATCH /users/{id} - Partial User Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status field patched to inactive\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"inactive\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{created_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{created_user_id}}"]
            }
          }
        },
        {
          "name": "DELETE /users/{id} - Delete User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Confirmation message received\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{created_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{created_user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Negative Scenarios",
      "item": [
        {
          "name": "POST /users - 409 Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Duplicate User\",\n    \"email\": \"alice@example.com\",\n    \"role\": \"admin\",\n    \"status\": \"active\",\n    \"age\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "POST /users - 422 Missing Mandatory Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"no_name@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "GET /users/99999 - 404 Non-Existent User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/99999",
              "host": ["{{base_url}}"],
              "path": ["users", "99999"]
            }
          }
        },
        {
          "name": "POST /users - 401 Unauthorized (Missing Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"No Auth User\",\n    \"email\": \"noauth@example.com\",\n    \"role\": \"tester\",\n    \"age\": 25\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Health Check",
      "item": [
        {
          "name": "GET /health - Service Healthcheck",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service is healthy\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"healthy\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}

