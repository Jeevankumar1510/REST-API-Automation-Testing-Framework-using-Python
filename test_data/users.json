        "status": "active",
        "age": 30
      },
      "expected_status": 422
    }
  ],
  "authentication_test_cases": [
    {
      "description": "Valid test user credentials",
      "username": "testuser@example.com",
      "password": "SecretPass123!",
      "expected_status": 200,
      "expect_token": true
    },
    {
      "description": "Valid admin credentials",
      "username": "admin@example.com",
      "password": "AdminPass123!",
      "expected_status": 200,
      "expect_token": true
    },
    {
      "description": "Invalid password for existing user",
      "username": "admin@example.com",
      "password": "WrongPassword999!",
      "expected_status": 401,
      "expect_token": false
    },
    {
      "description": "Non-existent user account",
      "username": "ghost_user@example.com",
      "password": "SomePassword123!",
