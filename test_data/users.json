  "invalid_users_missing_fields": [
    {
      "description": "Missing 'name' field",
      "payload": {
        "email": "missing.name@example.com",
        "role": "tester",
        "status": "active",
        "age": 25
      },
      "expected_status": 422
    },
    {
      "description": "Missing 'email' field",
      "payload": {
        "name": "No Email User",
        "role": "tester",
        "status": "active",
        "age": 25
      },
      "expected_status": 422
    },
    {
      "description": "Missing 'role' field",
      "payload": {
        "name": "No Role User",
        "email": "norole@example.com",
        "status": "active",
        "age": 25
      },
      "expected_status": 422
    },
    {
      "description": "Missing 'age' field",
      "payload": {
        "name": "No Age User",
        "email": "noage@example.com",
        "role": "tester",
        "status": "active"
      },
      "expected_status": 422
    }
  ],
  "invalid_users_wrong_types": [
    {
      "description": "Age as string instead of integer",
      "payload": {
        "name": "String Age User",
        "email": "str.age@example.com",
        "role": "tester",
        "status": "active",
        "age": "twenty-five"
      },
      "expected_status": 422
    },
    {
      "description": "Age as boolean",
      "payload": {
        "name": "Bool Age User",
        "email": "bool.age@example.com",
        "role": "tester",
        "status": "active",
        "age": true
      },
      "expected_status": 422
    }
  ],
  "invalid_users_out_of_range": [
    {
      "description": "Age below 18 limit",
      "payload": {
        "name": "Underage User",
        "email": "underage@example.com",
        "role": "guest",
        "status": "active",
        "age": 16
      },
      "expected_status": 422
    },
    {
      "description": "Age above 100 limit",
      "payload": {
        "name": "Centenarian User",
        "email": "old@example.com",
        "role": "guest",
        "status": "active",
        "age": 105
      },
      "expected_status": 422
    }
  ],
  "invalid_users_bad_email": [
    {
      "description": "Missing @ and domain in email",
      "payload": {
        "name": "Bad Email User",
